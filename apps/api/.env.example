# ============================================================
# APPLICATION
# ============================================================
NODE_ENV=development
API_PORT=4000
APP_URL=http://localhost:3001
API_URL=http://localhost:4000
# Dashboard origins allowed to call the admin API (comma-separated). Widget endpoints accept any origin.
CORS_ALLOWED_ORIGINS=http://localhost:3001

# ============================================================
# MONGODB
# ============================================================
# Local (docker-compose starts a single-node replica set "rs0"):
MONGODB_URI=mongodb://localhost:27017/ai_lead_gen?replicaSet=rs0
# Atlas: mongodb+srv://user:password@cluster.xxxxx.mongodb.net/ai_lead_gen?retryWrites=true&w=majority
MONGODB_DB_NAME=ai_lead_gen
MONGODB_MIN_POOL_SIZE=5
MONGODB_MAX_POOL_SIZE=20

# ============================================================
# JWT / AUTH  (min 32 chars each - REQUIRED in production)
# ============================================================
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-another-random-string-of-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
ENCRYPTION_KEY=change-me-32-chars-encryption-key!

# ============================================================
# PLATFORM OWNER (SUPER ADMIN) - created/refreshed by `npm run seed`
# Login at the dashboard with tenant slug "owner"
# ============================================================
SUPER_ADMIN_TENANT_SLUG=owner
SUPER_ADMIN_TENANT_NAME=Platform Owner
SUPER_ADMIN_EMAIL=superadmin@lead.ai
SUPER_ADMIN_PASSWORD=SuperAdmin@Lead.AI
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin

# ============================================================
# AI PROVIDERS  (openai | anthropic). Embeddings always use OpenAI.
# ============================================================
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ============================================================
# EMAIL - appointment confirmations, team notifications, follow-up emails to leads
# EMAIL_PROVIDER=smtp (any SMTP: Gmail app password, Outlook, Zoho, SES) or resend
# ============================================================
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# SMTP_SECURE=true only for port 465
SMTP_EMAIL=you@gmail.com
SMTP_PASSWORD=your-app-password
FROM_NAME=AI Lead Generation
FROM_EMAIL=you@gmail.com
# Resend alternative
RESEND_API_KEY=

# ============================================================
# SMS / WHATSAPP (Twilio) - follow-up SMS/WhatsApp to leads, and the voice
# number used to bridge salesperson calls (click-to-call, recorded)
# ============================================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=

# ============================================================
# AI CALLING (Vapi) - the agent that phones every new lead, qualifies it and
# hands hot ones to your team. Tenants can bring their own keys under
# Dashboard > Settings > API Credentials; these are the platform fallbacks.
#   1. Create an account at https://dashboard.vapi.ai and copy the PRIVATE key
#   2. Phone Numbers > import your Twilio number (or buy one) > copy its id
#   3. Pick any long random string as the webhook secret
# ============================================================
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
# Optional: a hand-tuned assistant from the Vapi dashboard. Leave empty to use
# the script configured under Dashboard > Settings > AI Calling.
VAPI_ASSISTANT_ID=
VAPI_WEBHOOK_SECRET=

# Vapi and Twilio POST call reports back to this API, so it must be reachable
# from the internet. Production: your real API domain. Development: an ngrok
# tunnel (ngrok http 4000) - e.g. https://abc123.ngrok-free.app
PUBLIC_API_URL=http://localhost:4000

# ============================================================
# GOOGLE CALENDAR (meeting sync + free/busy for AI booking)
# Google Cloud Console > APIs & Services > Credentials > OAuth client (Web application)
#   Authorised redirect URI: <PUBLIC_API_URL>/api/v1/calendar/google/callback
#   Enable "Google Calendar API" for the project. Each salesperson then clicks
#   "Connect Google Calendar" on the Appointments page.
# ============================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override; defaults to <PUBLIC_API_URL>/api/v1/calendar/google/callback
GOOGLE_REDIRECT_URI=

# WhatsApp templates (Twilio Content SIDs, approved for WhatsApp)
WHATSAPP_TPL_THANK_YOU=
WHATSAPP_TPL_APPOINTMENT=
WHATSAPP_TPL_CALLBACK=
WHATSAPP_TPL_MISSED_CALL=
WHATSAPP_TPL_REENGAGE=
WHATSAPP_TPL_REMINDER=
WHATSAPP_TPL_MISSED_MEETING=

# Meeting reminders / no-show sweep (inside the API process, one replica)
APPOINTMENT_REMINDER_POLL_INTERVAL_MS=60000

# Two-way WhatsApp AI (Twilio). Point the WhatsApp sender's "message comes in"
# webhook at <PUBLIC_API_URL>/api/v1/whatsapp/twilio/inbound/<tenantId> (the
# dashboard can set it for you). Webhooks are signature-checked; set to false
# only behind a tunnel whose URL differs from PUBLIC_API_URL.
WHATSAPP_VERIFY_SIGNATURE=true

# Inbound AI receptionist: Vapi asks us which assistant should answer when your
# number rings. The workspace is found from the Vapi phone number id it saved
# under API Credentials; on a single-workspace install set it here instead.
#INBOUND_TENANT_ID=

# ============================================================
# BILLING (Razorpay) - the platform charging its workspaces
# Dashboard > Settings > API Keys. Without these the dashboard still creates
# an invoice, but the customer pays offline and an owner activates the plan.
# ============================================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Schedulers run inside the API process (one replica only, like the others):
# queue poll = how often due AI calls are dialed; re-engage = cold-lead sweep;
# task poll = due-now nudges + overdue escalation to admins.
CALLING_SCHEDULER_ENABLED=true
CALLING_POLL_INTERVAL_MS=5000
CALLING_REENGAGE_INTERVAL_MS=3600000
FOLLOW_UP_TASK_SCHEDULER_ENABLED=true
FOLLOW_UP_TASK_POLL_INTERVAL_MS=300000

# ============================================================
# TEAM CHAT (optional global fallbacks; per-tenant URLs are set in Dashboard > Settings > Notifications)
# ============================================================
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=

# ============================================================
# FOLLOW-UP SCHEDULER
# Runs inside the API process. With several API replicas keep it enabled on ONE instance only
# (set FOLLOW_UP_SCHEDULER_ENABLED=false on the others) - due steps are claimed atomically, so
# duplicates cannot run, but a single scheduler avoids needless polling.
# ============================================================
FOLLOW_UP_SCHEDULER_ENABLED=true
FOLLOW_UP_POLL_INTERVAL_MS=60000

# ============================================================
# PLAN / TRIAL EXPIRY REMINDERS
# Emails + in-app alerts to tenant admins N days before a trial or paid plan ends (once per expiry).
# Same replica advice as the follow-up scheduler.
# ============================================================
PLAN_REMINDER_ENABLED=true
PLAN_REMINDER_DAYS_BEFORE=7
PLAN_REMINDER_POLL_INTERVAL_MS=3600000

# ============================================================
# RATE LIMITING (per IP)
# ============================================================
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ============================================================
# UPSTASH REDIS (optional cache - app runs without it)
# ============================================================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ============================================================
# STORAGE (MinIO / S3) - knowledge base file uploads
# ============================================================
STORAGE_PROVIDER=s3
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=ap-south-1
S3_BUCKET=ai-lead-gen-uploads
S3_ENDPOINT=http://localhost:9000

# ============================================================
# WEBHOOKS / SWAGGER
# ============================================================
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_RETRIES=3
SWAGGER_ENABLED=true

# ============================================================
# AI Automation - Google Maps prospecting
# ============================================================
# Places API (New) key from Google Cloud. Enable "Places API (New)" on the
# project and keep billing on - Text Search and Place Details are both billed.
# Without this key the AI Automation pages load but runs are refused.
GOOGLE_PLACES_API_KEY=

# Scheduled campaigns run from inside the API process. With several API
# replicas, set this to false on all but one.
LEAD_AUTOMATION_SCHEDULER_ENABLED=true
LEAD_AUTOMATION_POLL_INTERVAL_MS=300000

# ─────────────────────────────────────────────────────────────────
# Leads Scrap AI - Reddit / Hacker News / Quora / web prospecting
# ─────────────────────────────────────────────────────────────────
# Every source below runs on a FREE tier. Leave a block empty and that
# source simply shows as "not configured" in the dashboard - nothing breaks.

# Reddit Data API. Create a "script" app at https://www.reddit.com/prefs/apps
# Free tier = 100 queries/minute, NON-COMMERCIAL use only. For a commercial
# deployment each workspace should supply its own app credentials.
# User agent must be descriptive or Reddit returns 429 immediately.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=
REDDIT_TOKEN_URL=https://www.reddit.com/api/v1/access_token
REDDIT_API_BASE_URL=https://oauth.reddit.com

# Hacker News (Algolia). Completely free, no key, no signup required.
HN_API_BASE_URL=https://hn.algolia.com/api/v1

# SERP API - powers the Quora and Web sources (Quora has no public API).
# Free tier is ~100 searches/month, so the per-run search budget is kept small.
# Get a key at https://serpapi.com/manage-api-key
SERPAPI_API_KEY=
SERPAPI_BASE_URL=https://serpapi.com/search.json
SERP_ENGINE=google
SERP_MAX_SEARCHES_PER_RUN=6
SERP_RESULTS_PER_SEARCH=20
# Phrases are OR-batched into one paid search ("a" OR "b" OR ...). Raising this
# stretches the free quota further; Google truncates very long queries, so 5 is
# a safe ceiling.
SERP_KEYWORDS_PER_SEARCH=5

# Hard ceiling on stored prospects per run, and outbound HTTP timeout.
SOCIAL_PROSPECTING_MAX_RESULTS=300
# Outreach drafting is one AI call per post - bounded separately from fetching.
SOCIAL_PROSPECTING_MAX_MESSAGES_PER_RUN=25
SOCIAL_PROSPECTING_HTTP_TIMEOUT_MS=30000

# Scheduled campaigns run inside the API process. With several API replicas,
# set this to false on all but one.
SOCIAL_PROSPECTING_SCHEDULER_ENABLED=true
SOCIAL_PROSPECTING_POLL_INTERVAL_MS=300000

# Public tenders (EU / UK / Canada) - open government data, no credentials.
# Only override these if you proxy the feeds.
TED_API_URL=https://api.ted.europa.eu/v3/notices/search
UK_FTS_API_URL=https://www.find-tender.service.gov.uk/api/1.0/ocdsReleasePackages
CANADABUYS_CSV_URL=https://canadabuys.canada.ca/opendata/pub/openTenderNotice-ouvertAvisAppelOffres.csv

# Bluesky - free account + App Password (bsky.app > Settings > App Passwords).
# Post search requires a session; the public host no longer serves it.
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=
BLUESKY_API_URL=https://bsky.social

# Stack Exchange - works with no key on a small shared quota.
# A free key from stackapps.com raises it to 10,000 requests/day.
STACK_EXCHANGE_KEY=
STACK_EXCHANGE_API_URL=https://api.stackexchange.com/2.3
STACK_EXCHANGE_SITES=softwarerecs,webmasters,serverfault

# GitHub - works with no token at 10 searches/min; a free PAT raises it to 30.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
