# Canonical origin of this marketing site. Used for canonical URLs, sitemap,
# robots.txt and every absolute Open Graph / JSON-LD URL. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://leadbells.com

# Where the actual product lives. Every "Sign in" / "Start free" button points
# here, so the marketing site can be deployed separately from the app.
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Optional: Google Search Console verification token (meta tag).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
